def write_inventory(controller_ip, target_ips)
  File.open(INVENTORY_FILE, "w") do |f|
    f.puts "[controller]"
    f.puts controller_ip
    f.puts "\n[target]"
    target_ips.each { |ip| f.puts ip }
  end
end

        systemctl status ssh | head -n 10 || echo "SSH service status check failed."
        systemctl status nginx | head -n 10 || echo "Nginx service status check failed."
        # Centralized logging
        echo "Web Node #{i+1} health check at $(date)" >> #{LOG_DIR}/web#{i+1}.log
      SHELL
      if ENABLE_SNAPSHOTS
        web.vm.provider "virtualbox" do |vb|
          vb.customize ["snapshot", :id, "take", "initial"]
        end
      end
    end
  end


  # Example: Role-based VM creation
  # Dynamic web nodes
  WEB_COUNT.times do |i|
    config.vm.define "web#{i+1}" do |web|
      web.vm.box = VM_BOX
      web.vm.box_version = VM_BOX_VERSION
      web.vm.hostname = "web-node#{i+1}"
      web.vm.network "private_network", ip: static_ip(1 + i)
      web.vm.network "forwarded_port", guest: 80, host: 8080 + i, id: "http#{i+1}"
      PROVIDERS.each do |prov|
        web.vm.provider prov do |vb|
          vb.memory = 1024
          vb.cpus = 1
          vb.customize ["modifyvm", :id, "--description", "Web Node #{i+1}"] if prov == "virtualbox"
          vb.customize ["modifyvm", :id, "--vrdxvmsize", 10240] if prov == "virtualbox"
        end
      end
      ENV_VARS.each { |k, v| web.vm.env.push({ k => v }) }
      RESOURCE_TAGS.merge({"role" => "web"}).each { |k, v| web.vm.provider "virtualbox" do |vb| vb.customize ["setextradata", :id, "VBoxInternal/Tags/#{k}", v] end }
      # Custom networking topologies
      NETWORKS.each do |net|
        web.vm.network net[:type], ip: net[:ip] if net[:ip]
      end
      web.vm.provision "shell", inline: <<-SHELL
        set -e
        trap 'echo "[ERROR] Provisioning failed on web-node#{i+1}!" >&2; exit 1' ERR
        export DEBIAN_FRONTEND=noninteractive
        sudo apt-get update
        sudo apt-get install -y curl git python3-pip htop glances nginx
        if ! id #{CUSTOM_USER} >/dev/null 2>&1; then
          sudo adduser --disabled-password --gecos "" #{CUSTOM_USER}
          sudo usermod -aG sudo #{CUSTOM_USER}
          sudo mkdir -p /home/#{CUSTOM_USER}/.ssh
          if [ -f #{CUSTOM_USER_PUBKEY} ]; then
            sudo cp #{CUSTOM_USER_PUBKEY} /home/#{CUSTOM_USER}/.ssh/authorized_keys
          fi
          sudo chown -R #{CUSTOM_USER}:#{CUSTOM_USER} /home/#{CUSTOM_USER}/.ssh
          sudo chmod 600 /home/#{CUSTOM_USER}/.ssh/authorized_keys
        fi
        sudo mkdir -p /etc/ansible/facts.d
        echo '{"role": "web", "lab_type": "advanced", "owner": "Dewain"}' | sudo tee /etc/ansible/facts.d/lab.json
        htop --version
        glances --version
        nginx -v
        sudo apt-get clean
        # Automated package updates
        if #{AUTO_UPDATE_PACKAGES}; then
          sudo apt-get upgrade -y
        fi
        # Centralized logging
        echo "Web Node #{i+1} provisioned at $(date)" >> #{LOG_DIR}/web#{i+1}.log
      SHELL
      web.vm.provision "shell", inline: <<-SHELL
        echo "[HEALTH CHECK] Web Node #{i+1}:"

        echo "#{static_ip(0)}" >> #{INVENTORY_FILE}
        echo "\n[target]" >> #{INVENTORY_FILE}
        for i in $(seq 1 #{NUM_TARGETS}); do
          echo "#{static_ip(i)}" >> #{INVENTORY_FILE}
        done
      SHELL
    }
  end

#===============================================================================
# Vagrantfile for Deploying an Ansible Controller Node on VirtualBox
#
# Description:
#   This Vagrantfile sets up a single virtual machine running Ubuntu (focal64) that will
#   serve as an Ansible controller. It performs the following:
#     1. Uses VirtualBox as the provider.
#     2. Configures a private network (DHCP).
#     3. Customizes VM resources (memory, CPU).
#     4. Installs Ansible, Ansible Lint, and Ansible Vault via inline shell provisioning.
#     5. Creates a synced folder between host and guest for sharing playbooks or configuration.
#     6. Enables SSH agent forwarding for convenient key management.
#
# Prerequisites:
#   - VirtualBox and Vagrant must be installed on your host machine.
#   - Ensure that the OpenShift credentials and other sensitive information are secured.
#
# Disclaimer:
#   This file is provided "as is" without any warranty of any kind. Use at your own risk.
#
# Author: Dewain Smith, #TheBeardedEngineer
# Date:   2025-08-13
# Version: 1.2
#===============================================================================


################################################################################
# Configurable Parameters
# These variables control VM resources, networking, and provisioning features.
# Adjust them to customize your Ansible lab environment.
################################################################################
VM_BOX = "ubuntu/focal64" # Use Ubuntu 20.04 LTS
VM_BOX_VERSION = "20240403.0.0" # Pin box version for reproducibility
VM_HOSTNAME_CONTROLLER = "ansible-controller"
VM_HOSTNAME_PREFIX_TARGET = "ansible-target"
VM_MEMORY_CONTROLLER = 2048
VM_CPUS_CONTROLLER = 2

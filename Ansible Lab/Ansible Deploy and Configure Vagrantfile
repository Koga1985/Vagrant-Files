#===============================================================================
# Vagrantfile for Deploying an Ansible Controller Node on VirtualBox
#
# Description:
#   This Vagrantfile sets up a single virtual machine running Ubuntu (focal64) that will
#   serve as an Ansible controller. It performs the following:
#     1. Uses VirtualBox as the provider.
#     2. Configures a private network (DHCP).
#     3. Customizes VM resources (memory, CPU).
#     4. Installs Ansible, Ansible Lint, and Ansible Vault via inline shell provisioning.
#     5. Creates a synced folder between host and guest for sharing playbooks or configuration.
#     6. Enables SSH agent forwarding for convenient key management.
#
# Prerequisites:
#   - VirtualBox and Vagrant must be installed on your host machine.
#   - Ensure that the OpenShift credentials and other sensitive information are secured.
#
# Disclaimer:
#   This file is provided "as is" without any warranty of any kind. Use at your own risk.
#
# Author: Dewain Smith, #TheBeardedEngineer
# Date:   2025-08-13
# Version: 1.2
#===============================================================================


#-----------------------------
# Configurable Parameters
#-----------------------------
VM_BOX = "ubuntu/focal64" # Use Ubuntu 20.04 LTS
VM_BOX_VERSION = "20240403.0.0" # Pin box version for reproducibility
VM_HOSTNAME_CONTROLLER = "ansible-controller"
VM_HOSTNAME_PREFIX_TARGET = "ansible-target"
VM_MEMORY_CONTROLLER = 2048
VM_CPUS_CONTROLLER = 2
VM_MEMORY_TARGET = 1024
VM_CPUS_TARGET = 1
NUM_TARGETS = 2 # Number of target VMs
SYNCED_FOLDER_SRC = "./ansible"
SYNCED_FOLDER_DEST = "/vagrant_ansible"
PORT_FORWARD_SSH = 2222 # Host port for controller SSH
STATIC_IP_BASE = "192.168.56."
STATIC_IP_START = 10
PROVIDERS = ["virtualbox", "vmware_desktop", "hyperv"] # Multi-provider support

#-----------------------------
# Helper: Generate Static IPs
#-----------------------------
def static_ip(index)
  "#{STATIC_IP_BASE}#{STATIC_IP_START + index}"
end



Vagrant.configure("2") do |config|
  #-----------------------------
  # Controller Node
  #-----------------------------
  config.vm.define "controller" do |controller|
    controller.vm.box = VM_BOX
    controller.vm.box_version = VM_BOX_VERSION
    controller.vm.hostname = VM_HOSTNAME_CONTROLLER
    controller.vm.network "private_network", ip: static_ip(0)
    controller.vm.network "forwarded_port", guest: 22, host: PORT_FORWARD_SSH, id: "ssh"
    # Multi-provider support
    PROVIDERS.each do |prov|
      controller.vm.provider prov do |vb|
        vb.memory = VM_MEMORY_CONTROLLER
        vb.cpus = VM_CPUS_CONTROLLER
        vb.customize ["modifyvm", :id, "--description", "Ansible Controller"] if prov == "virtualbox"
      end
    end
    controller.vm.synced_folder SYNCED_FOLDER_SRC, SYNCED_FOLDER_DEST, type: "virtualbox"
    controller.ssh.forward_agent = true
    controller.vm.provision "shell", inline: <<-SHELL
      set -e
      trap 'echo "[ERROR] Provisioning failed on controller!" >&2; exit 1' ERR
      export DEBIAN_FRONTEND=noninteractive
      sudo apt-get update
      sudo apt-get install -y software-properties-common curl git python3-pip
      if ! apt-cache policy | grep -q ansible; then
        sudo apt-add-repository --yes --update ppa:ansible/ansible
      fi
      sudo apt-get update
      sudo apt-get install -y ansible
      pip3 install --user --upgrade ansible-lint ansible-vault
      # Custom user and SSH key setup
      if ! id #{CUSTOM_USER} >/dev/null 2>&1; then
        sudo adduser --disabled-password --gecos "" #{CUSTOM_USER}
        sudo usermod -aG sudo #{CUSTOM_USER}
        sudo mkdir -p /home/#{CUSTOM_USER}/.ssh
        if [ -f #{CUSTOM_USER_PUBKEY} ]; then
          sudo cp #{CUSTOM_USER_PUBKEY} /home/#{CUSTOM_USER}/.ssh/authorized_keys
        fi
        sudo chown -R #{CUSTOM_USER}:#{CUSTOM_USER} /home/#{CUSTOM_USER}/.ssh
        sudo chmod 600 /home/#{CUSTOM_USER}/.ssh/authorized_keys
      fi
      # Ansible Vault secrets management
      if [ -f #{SECRETS_FILE} ]; then
        echo "Vault password file found at #{SECRETS_FILE}."
      else
        echo "Vault password file not found. Secrets will not be available." >&2
      fi
      # Inject custom Ansible facts
      sudo mkdir -p /etc/ansible/facts.d
      echo '{"lab_type": "advanced", "owner": "Dewain"}' | sudo tee /etc/ansible/facts.d/lab.json
      ansible --version
      ansible-lint --version
      ansible-vault --version
      sudo apt-get clean
    SHELL
  end

  #-----------------------------
  # Target Nodes (Prepared for Expansion)
  #-----------------------------
  NUM_TARGETS.times do |i|
    config.vm.define "target#{i+1}" do |target|
      target.vm.box = VM_BOX
      target.vm.box_version = VM_BOX_VERSION
      target.vm.hostname = "#{VM_HOSTNAME_PREFIX_TARGET}#{i+1}"
      target.vm.network "private_network", ip: static_ip(i+1)
      PROVIDERS.each do |prov|
        target.vm.provider prov do |vb|
          vb.memory = VM_MEMORY_TARGET
          vb.cpus = VM_CPUS_TARGET
          vb.customize ["modifyvm", :id, "--description", "Ansible Target Node #{i+1}"] if prov == "virtualbox"
        end
      end
      # Custom user and SSH key setup for target nodes
      target.vm.provision "shell", inline: <<-SHELL
        set -e
        trap 'echo "[ERROR] Provisioning failed on target#{i+1}!" >&2; exit 1' ERR
        export DEBIAN_FRONTEND=noninteractive
        sudo apt-get update
        sudo apt-get install -y curl git python3-pip
        if ! id #{CUSTOM_USER} >/dev/null 2>&1; then
          sudo adduser --disabled-password --gecos "" #{CUSTOM_USER}
          sudo usermod -aG sudo #{CUSTOM_USER}
          sudo mkdir -p /home/#{CUSTOM_USER}/.ssh
          if [ -f #{CUSTOM_USER_PUBKEY} ]; then
            sudo cp #{CUSTOM_USER_PUBKEY} /home/#{CUSTOM_USER}/.ssh/authorized_keys
          fi
          sudo chown -R #{CUSTOM_USER}:#{CUSTOM_USER} /home/#{CUSTOM_USER}/.ssh
          sudo chmod 600 /home/#{CUSTOM_USER}/.ssh/authorized_keys
        fi
  # Inject custom Ansible facts
  sudo mkdir -p /etc/ansible/facts.d
  echo '{"lab_type": "advanced", "owner": "Dewain"}' | sudo tee /etc/ansible/facts.d/lab.json
  sudo apt-get clean
      SHELL
    end
  end
end
